# 复制为 .env 后按需填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不要把真实密钥提交到仓库。

# ===== Docker Compose（方式一）=====
# admin 以非回环地址 :8092 启动，必须配置，否则拒绝启动。
# 生成一个随机值：openssl rand -hex 32
ADMIN_KEY=

# ai.yaml 通过 ${ZHIPU_API_KEY} / ${DEEPSEEK_API_KEY} 展开；只用 mock 时可为空。
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# ===== 本地 go run（方式二）=====
# compose 的 environment 会覆盖这三项，本地直接跑进程时必须正确填写。
DATABASE_URL=postgres://flowgate:flowgate@localhost:5433/flowgate
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=flowgate

# 本地联调 mock（127.0.0.1:8091）时放行回环；留空 = 禁止所有内网地址。
ALLOW_UPSTREAM_CIDRS=127.0.0.1/32
